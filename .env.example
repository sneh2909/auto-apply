# Copy to .env and fill in.

# === Paths ===
AUTOAPPLY_HOME=./data                         # browser profile, logs land here
CONFIG_DIR=./config
RESUME_PDF=./config/resume.pdf

# === MongoDB ===
MONGO_URI=mongodb://localhost:27017
MONGO_DB=autoapply

# === Gmail (the dedicated sender account, not your primary) ===
GMAIL_CLIENT_SECRETS=./config/gmail_credentials.json
GMAIL_TOKEN_PATH=./data/gmail_token.json
GMAIL_LABEL_UNPROCESSED=JobAlerts/Unprocessed
GMAIL_LABEL_PROCESSED=JobAlerts/Processed
GMAIL_LABEL_APPLIED_OUT=Applied/Sent
GMAIL_LABEL_REPLY=Applied/Reply
GMAIL_USER_EMAIL=                              # dedicated sender, e.g. yourname.apply@gmail.com
GMAIL_SENDER_NAME=                             # display name on outbound mail

# === LLM providers (only fill the ones you'll use) ===
SARVAM_API_KEY=                                # optional fallback for provider=sarvam

# Scoring (small + frequent — needs cheap or free tier)
SCORER_PROVIDER=gemini                         # gemini | groq | sarvam
SCORER_MODEL=gemini/gemini-2.0-flash           # LiteLLM model id
SCORER_API_KEY=
SCORER_SERVICE_ACCOUNT_JSON=                   # optional: ./config/service_account.json for Gemini/Vertex auth
SCORER_GOOGLE_CLOUD_LOCATION=us-central1       # used with service-account auth

# Composing emails (less frequent, higher quality)
COMPOSER_PROVIDER=groq
COMPOSER_MODEL=groq/llama-3.3-70b-versatile
COMPOSER_API_KEY=

# Channel D agent (DOM-driving)
AGENT_PROVIDER=groq                            # gemini | groq | sarvam
AGENT_MODEL=groq/llama-3.3-70b-versatile       # use gemini/gemini-2.0-flash for Gemini
AGENT_API_KEY=                                 # optional for groq if COMPOSER_API_KEY is set
AGENT_SERVICE_ACCOUNT_JSON=                    # optional: ./config/service_account.json for Gemini/Vertex auth
AGENT_GOOGLE_CLOUD_LOCATION=us-central1        # used with service-account auth

# === ATS ingest (optional; needs slugs in config/companies.yaml) ===
INGEST_ATS_SOURCES=0                           # 1 = poll Greenhouse/Lever boards listed in companies.yaml

# === Scrapers ===
# Comma-separated list of portals to enable. Remove any you don't want.
# linkedin requires scripts/setup_linkedin_login.py first.
SCRAPER_PORTALS=["linkedin","naukri","foundit","instahyre"]

# === Operational ===
DAILY_SEND_CAP=10
FIT_THRESHOLD=6.5
COOLDOWN_DAYS=30
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
HEADLESS_BROWSER=1                             # 1 = headless (background), 0 = visible window
